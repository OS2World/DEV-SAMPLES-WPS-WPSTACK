/*
 * Class Creation and Initialization
 */

SOMClass * SOMLINK M_StackNewClass (integer4 somtmajorVersion,
		integer4 somtminorVersion)
{
    SOMClass *result;

    if (_M_Stack && _somCheckVersion(_M_Stack, somtmajorVersion, somtminorVersion))
          return _M_Stack;
    M_WPAbstractNewClass(M_WPAbstract_MajorVersion,M_WPAbstract_MinorVersion);	/* static reference */
    result = somBuildClass(0xFFFFFFFF,&M_StackSCI, somtmajorVersion, somtminorVersion);
    M_Stack_parent_M_WPAbstract_wpclsQueryIconData_resolved = 
	somParentNumResolve(M_StackCClassData.parentMtab, 1, M_WPObjectClassData.wpclsQueryIconData); 
    M_Stack_parent_M_WPAbstract_wpclsQueryDefaultView_resolved = 
	somParentNumResolve(M_StackCClassData.parentMtab, 1, M_WPObjectClassData.wpclsQueryDefaultView); 
    M_Stack_parent_M_WPAbstract_wpclsQueryDefaultHelp_resolved = 
	somParentNumResolve(M_StackCClassData.parentMtab, 1, M_WPObjectClassData.wpclsQueryDefaultHelp); 
    M_Stack_parent_M_WPAbstract_wpclsInitData_resolved = 
	somParentNumResolve(M_StackCClassData.parentMtab, 1, M_WPObjectClassData.wpclsInitData); 
    return result;
}

