/*
 * Class Creation and Initialization
 */

SOMClass * SOMLINK StackNewClass (integer4 somtmajorVersion,
		integer4 somtminorVersion)
{
    SOMClass *result;

    if (_Stack && _somCheckVersion(_Stack, somtmajorVersion, somtminorVersion))
          return _Stack;
    WPAbstractNewClass(WPAbstract_MajorVersion,WPAbstract_MinorVersion);	/* static reference */
    /* Explicit metaclass, so get it */ 
    M_StackNewClass(M_Stack_MajorVersion,M_Stack_MinorVersion);	/* static reference */
    result = somBuildClass(0xFFFFFFFF,&StackSCI, somtmajorVersion, somtminorVersion);
    Stack_parent_WPAbstract_wpUnInitData_resolved = 
	somParentNumResolve(StackCClassData.parentMtab, 1, WPObjectClassData.wpUnInitData); 
    Stack_parent_WPAbstract_wpSetupOnce_resolved = 
	somParentNumResolve(StackCClassData.parentMtab, 1, WPObjectClassData.wpSetupOnce); 
    Stack_parent_WPAbstract_wpSetup_resolved = 
	somParentNumResolve(StackCClassData.parentMtab, 1, WPObjectClassData.wpSetup); 
